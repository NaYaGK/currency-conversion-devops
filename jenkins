        stage('jfrog package') {
            steps {
                sh 'mvn package'
            }
            post {
                success {
                    archiveArtifacts artifacts: '**/target/*.jar, **/target/*.war',
                                     fingerprint: true
                }
            }
        }
        stage('upload') {
            steps {
                script {
                    def server = Artifactory.server('jfrog')
                    def uploadjar = """{
                        "files": [{
                            "pattern": "./target/*.jar",
                           "target": "currency-conversion-local/"
                        }]
                    }"""
                    server.upload(uploadjar)
                }               // closes script ✅
            }                   // closes steps ✅
        }                       // closes stage('upload') ✅

        stage('Docker Build') {
            steps {
                script {
                    // Make sure the tag matches what you use!
                    sh 'sudo docker build --no-cache -t currency-conversion:1.04 .'
                }
            }
        }

        stage('Trivy Scan') {
            steps {
                script {
                    // If Trivy finds CRITICAL/HIGH vulnerabilities, it should exit with a non-zero code to fail the build (e.g. --exit-code 1).
                    // For now, we will run the scan.
                    sh 'sudo TMPDIR=/home/ec2-user/trivy-temp trivy image currency-conversion:1.04'
                }
            }
        }

        stage('Docker Push') {
            steps {
                script {
                    // Note: In a real enterprise pipeline, you would use withCredentials() to handle passwords securely.
                    // Assuming you have already authenticated the Jenkins server to Docker Hub using 'docker login'
                    sh 'sudo docker tag currency-conversion:1.04 karthikganji/currency-conversion:1.04'
                    sh 'sudo docker push karthikganji/currency-conversion:1.04'
                }
            }
        }
    }                           // closes stages ✅
    post {
        failure {
            echo 'Pipeline failed'
        }
        success {
            echo 'Pipeline succeeded'
        }
    }
}                               // closes pipeline ✅



